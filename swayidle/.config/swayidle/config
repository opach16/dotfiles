timeout 60 'brightnessctl -sd platform::kbd_backlight set 0' resume 'brightnessctl -rd platform::kbd_backlight'

timeout 240 'niri msg action power-off-monitors' resume 'niri msg action power-on-monitors && brightnessctl -r'

timeout 300 'hyprlock'

timeout 360 'systemctl suspend'

before-sleep 'hyprlock'

after-resume 'niri msg action power-on-monitors'
