# >>> elio shell integration >>>
elio() {
    case "${1-}" in
        shell|-*)
            command elio "$@"
            return $?
            ;;
    esac

    local arg tmp cwd status_code
    for arg in "$@"; do
        case "$arg" in
            --chooser-file|--chooser-file=*)
                command elio "$@"
                return $?
                ;;
        esac
    done

    tmp="$(mktemp -t "elio-cwd.XXXXXX")" || return
    command elio --cwd-file "$tmp" "$@"
    status_code=$?

    if [ -s "$tmp" ]; then
        cwd="$(cat -- "$tmp")"
        rm -f -- "$tmp"
        if [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && [ -d "$cwd" ]; then
            cd -- "$cwd" || return $?
        fi
    else
        rm -f -- "$tmp"
    fi

    return "$status_code"
}
# <<< elio shell integration <<<
